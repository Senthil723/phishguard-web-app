# Copy this file to .env and adjust values as needed.
# Easy local development (SQLite):
DATABASE_URL=sqlite:///./phishguard.db
FRONTEND_ORIGINS=http://localhost:5173
SESSION_COOKIE_SECURE=false

# For an HTTPS deployment, set FRONTEND_ORIGINS to the public frontend origin
# and SESSION_COOKIE_SECURE=true. Use the same site for the frontend and API.

# For MySQL instead, install MySQL and change DATABASE_URL to:
# DATABASE_URL=mysql+pymysql://phishguard:YOUR_PASSWORD@localhost:3306/phishguard
