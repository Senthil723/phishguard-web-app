# Copy this file to .env and adjust values as needed.
# Easy local development (SQLite):
DATABASE_URL=sqlite:///./phishguard.db
FRONTEND_ORIGINS=http://localhost:5173
SESSION_COOKIE_SECURE=false

# For an HTTPS deployment, set FRONTEND_ORIGINS to the public frontend origin
# and SESSION_COOKIE_SECURE=true. Use the same site for the frontend and API.

# To copy existing SQLite data, first set this to an empty MySQL database.
# MYSQL_DATABASE_URL=mysql+pymysql://phishguard:YOUR_PASSWORD@localhost:3306/phishguard?charset=utf8mb4
# After the transfer succeeds, set DATABASE_URL to that same MySQL URL.

# Password reset mail. Use your SMTP provider's host, login, and sender.
# Port 587 uses STARTTLS; for port 465 set SMTP_USE_SSL=true.
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=false
